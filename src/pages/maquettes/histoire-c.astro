---
// Histoire C « Une carte par décennie » : cinq grandes cartes, chacune avec sa photo et la liste de ses événements à déplier.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import pages from '../../data/pages.json';
import { photo } from '../../lib/photo';
import { asset } from '../../lib/utils';
import { intro, decennies, etapes } from '../../lib/histoire';
---
<Base univers="club" title="Notre histoire (proposition C)">
  <PageHead eyebrow="Le club" image={pages.historique.image} title={pages.historique.titre} lead={intro} />
  <section class="section">
    <div class="container">
      <div class="chiffres"><div><b>1979</b><span>création du club</span></div><div><b>{etapes.length}</b><span>moments racontés</span></div><div><b>{decennies.length}</b><span>décennies</span></div></div>
      <div class="decs">
        {decennies.map((d, i) => (
          <article class:list={['dec', { inverse: i % 2 }]}>
            <div class="visuel">
              {d.photo ? <img {...photo(d.photo, '(min-width: 900px) 520px, 100vw')} alt="" loading="lazy" /> : <div class="aplat" />}
              <span>{d.court}</span>
            </div>
            <div class="liste">
              <h2>{d.nom}</h2>
              {d.etapes.map((e) => (
                <details>
                  <summary><b>{e.annee}</b>{e.titre}<i aria-hidden="true">+</i></summary>
                  <p>{e.texte}</p>
                  {e.photos.length > 0 && <div class="photos">{e.photos.map((p) => <a href={asset(p)} target="_blank"><img {...photo(p, '140px')} alt="" loading="lazy" /></a>)}</div>}
                </details>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .chiffres { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 36px; text-align: center; }
  .chiffres div { display: flex; flex-direction: column; } .chiffres div + div { border-left: 1px solid var(--line); }
  .chiffres b { font-family: var(--font-title); font-size: clamp(2.4rem, 4.5vw, 3.6rem); color: var(--marine); line-height: 1; } .chiffres span { color: var(--muted); }
  .decs { display: grid; gap: 28px; }
  .dec { display: grid; grid-template-columns: 1fr 1.3fr; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; }
  .dec.inverse .visuel { order: 2; }
  .visuel { position: relative; min-height: 300px; }
  .visuel img, .aplat { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .aplat { background: var(--marine); }
  .visuel::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(8,43,80,.75), transparent 55%); }
  .visuel span { position: absolute; left: 24px; bottom: 14px; z-index: 1; font-family: var(--font-title); font-weight: 700; font-size: clamp(3.4rem, 6vw, 5rem); color: #fff; line-height: 1; letter-spacing: -.03em; }
  .liste { padding: 26px 30px; }
  .liste h2 { font-size: 1.7rem; margin-bottom: 12px; }
  details { border-top: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: baseline; gap: 14px; padding: 12px 0; font-family: var(--font-title); font-weight: 600; color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  summary b { color: var(--rouge); min-width: 5.2em; }
  summary i { margin-left: auto; font-style: normal; color: var(--marine); transition: transform .2s; }
  details[open] summary i { transform: rotate(45deg); }
  details p { margin: 0 0 12px; color: var(--muted); font-size: .95rem; padding-left: calc(5.2em + 14px); }
  .photos { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; padding-left: calc(5.2em + 14px); }
  .photos img { width: 110px; height: 82px; object-fit: cover; border-radius: 10px; }
  @media (max-width: 899px) {
    .dec { grid-template-columns: 1fr; } .dec.inverse .visuel { order: 0; } .visuel { min-height: 200px; }
    details p, .photos { padding-left: 0; } .chiffres { grid-template-columns: 1fr; } .chiffres div + div { border: 0; }
  }
</style>
