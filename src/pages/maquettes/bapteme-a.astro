---
// Proposition A : deux portes avec photo (En passager / Aux commandes), puis le jour J, puis les questions.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Etapes from '../../components/Etapes.astro';
import Faq from '../../components/Faq.astro';
import pages from '../../data/pages.json';
import d from '../../data/decouvrir.json';
import { photo } from '../../lib/photo';
import { url } from '../../lib/utils';
import { n, passager, commandes, des, photoPassager, photoCommandes, etapes, questions, svg, ico, tel, telHref } from '../../lib/bapteme';
const reperes = [
  { t: 'Départ', x: 'Club-house, zone aéroplaisance de Beauvais-Tillé', s: svg.lieu },
  { t: 'Météo', x: 'Vol reporté sans frais si le temps ne le permet pas', s: svg.meteo },
  { t: 'Idée cadeau', x: 'Toutes les formules existent en bon cadeau', s: svg.cadeau },
  { t: 'Règlement', x: 'Virement, chèque ou espèces', s: svg.paiement },
];
---
<Base univers="decouvrir" title="Baptême de l'air (proposition A)">
  <PageHead eyebrow="Baptême de l'air" image={pages.decouvrir.image} title={pages.decouvrir.titre} lead={d.accroche}>
    <div class="btns" style="margin-top:22px"><a class="btn btn-jaune" href={url('/contact?objet=Vol découverte')}>Réserver un baptême</a><a class="btn btn-ghost" href={url('/contact?objet=Bon cadeau')}>Offrir un vol</a></div>
  </PageHead>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Nos formules</span>
      <h2>Deux façons de découvrir le vol</h2>
      <div class="portes">
        <article class="porte">
          <div class="p-photo"><img {...photo(photoPassager, '(min-width: 900px) 640px, 100vw')} alt="Un Robin DR400 du club en vol" /><span class="p-tag"><Fragment set:html={ico(svg.oeil)} /> En passager</span></div>
          <div class="p-corps">
            <h3>{passager.titre}</h3>
            <p>{passager.texte}</p>
            <ul class="lignes">{passager.prix.map((p) => <li><span>{p.libelle}</span><b>{n(p.prix)} €</b></li>)}</ul>
            <a class="btn btn-jaune" href={url('/contact?objet=Vol découverte')}>Réserver un vol découverte</a>
          </div>
        </article>
        <article class="porte">
          <div class="p-photo"><img {...photo(photoCommandes, '(min-width: 900px) 640px, 100vw')} alt="Un élève aux commandes, au-dessus de la campagne" /><span class="p-tag"><Fragment set:html={ico(svg.volant)} /> Aux commandes</span></div>
          <div class="p-corps">
            <h3>Prendre les commandes</h3>
            <p>Avec un instructeur du club, c'est vous qui pilotez.</p>
            <ul class="lignes">{commandes.map((f) => <li><span><strong>{f.titre}</strong><small>{f.texte}</small></span><b>{n(f.prix[0].prix)} €</b></li>)}</ul>
            <a class="btn btn-jaune" href={url("/contact?objet=Vol d'initiation")}>Réserver un vol d'initiation</a>
          </div>
        </article>
      </div>
      <ul class="reperes">
        {reperes.map((r) => <li><Fragment set:html={ico(r.s)} /><span><b>{r.t}</b>{r.x}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <span class="eyebrow">Le jour J</span>
      <h2>{d.deroulement_titre}</h2>
      <p class="lead">{d.intro}</p>
      <Etapes etapes={etapes} />
    </div>
  </section>

  <section class="section">
    <div class="container q-grille">
      <div>
        <span class="eyebrow">Questions fréquentes</span>
        <h2>Bon à savoir</h2>
        <Faq questions={questions} />
      </div>
      <aside class="appel">
        <h3>Une autre question ?</h3>
        <p>Le club vous répond par téléphone ou par e-mail.</p>
        <a class="btn btn-primary" href={telHref}>{tel}</a>
        <a class="btn btn-outline" href={url('/contact')}>Écrire au club</a>
      </aside>
    </div>
  </section>
</Base>
<style>
  .portes { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 8px; }
  .porte { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 22px; overflow: hidden; background: #fff; }
  .p-photo { position: relative; aspect-ratio: 16 / 9; }
  .p-photo img { width: 100%; height: 100%; object-fit: cover; }
  .p-tag { position: absolute; left: 18px; top: 18px; display: inline-flex; align-items: center; gap: 8px; background: var(--marine); color: #fff; font-family: var(--font-title); font-weight: 600; font-size: .9rem; padding: 7px 14px; border-radius: 999px; }
  .p-tag :global(svg) { width: 18px; height: 18px; }
  .p-corps { display: flex; flex-direction: column; flex: 1; padding: 26px 28px 28px; }
  .p-corps h3 { font-size: 1.6rem; margin: 0 0 6px; }
  .p-corps > p { color: var(--muted); margin-bottom: 14px; }
  .lignes { list-style: none; margin: 0 0 22px; padding: 0; border-top: 1px solid var(--line); flex: 1; }
  .lignes li { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .lignes span { display: flex; flex-direction: column; }
  .lignes small { color: var(--muted); font-size: .86rem; line-height: 1.35; }
  .lignes strong { font-family: var(--font-title); color: var(--ink); font-size: 1.08rem; }
  .lignes b { font-family: var(--font-title); font-size: 1.5rem; color: var(--marine); white-space: nowrap; }
  .p-corps .btn { align-self: flex-start; }
  .reperes { list-style: none; margin: 24px 0 0; padding: 20px 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; border: 1px solid var(--line); border-radius: 18px; }
  .reperes li { display: flex; gap: 12px; font-size: .9rem; color: var(--muted); line-height: 1.4; }
  .reperes li + li { border-left: 1px solid var(--line); padding-left: 18px; }
  .reperes :global(svg) { flex: none; width: 28px; height: 28px; color: var(--marine); }
  .reperes b { display: block; font-family: var(--font-title); color: var(--ink); font-size: 1rem; }
  .q-grille { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; align-items: start; }
  .appel { position: sticky; top: 110px; border: 1px solid var(--line); border-top: 4px solid var(--rouge); border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 10px; margin-top: 70px; }
  .appel h3 { margin: 0; } .appel p { color: var(--muted); margin: 0 0 6px; }
  .appel .btn { justify-content: center; }
  @media (max-width: 899px) {
    .portes, .q-grille { grid-template-columns: 1fr; }
    .reperes { grid-template-columns: 1fr 1fr; } .reperes li:nth-child(3) { border-left: 0; padding-left: 0; }
    .appel { position: static; margin-top: 0; }
  }
  @media (max-width: 499px) { .reperes { grid-template-columns: 1fr; } .reperes li + li { border-left: 0; padding-left: 0; } .p-corps { padding: 20px; } }
</style>
