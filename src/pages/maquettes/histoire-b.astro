---
// Histoire B « Moments forts + chapitres » : bande des moments en photos, puis sommaire des décennies collé à gauche et le récit à droite.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import pages from '../../data/pages.json';
import { photo } from '../../lib/photo';
import { asset } from '../../lib/utils';
import { intro, decennies, fortes } from '../../lib/histoire';
---
<Base univers="club" title="Notre histoire (proposition B)">
  <PageHead eyebrow="Le club" image={pages.historique.image} title={pages.historique.titre} lead={intro} />
  <section class="section dark">
    <div class="container">
      <span class="eyebrow">Depuis 1979</span>
      <h2>Les moments forts</h2>
      <ol class="forts">
        {fortes.map((e) => <li><a href={`#e${e.annee}`}><img {...photo(e.photos[0], '(min-width: 900px) 260px, 50vw')} alt="" loading="lazy" /><b>{e.annee}</b><span>{e.titre}</span></a></li>)}
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="container chap">
      <nav class="sommaire" aria-label="Décennies">
        <span class="eyebrow">Chapitres</span>
        {decennies.map((d) => <a href={`#${d.id}`}><b>{d.court}</b>{d.nom}</a>)}
      </nav>
      <div>
        {decennies.map((d) => (
          <section class="bloc" id={d.id}>
            <h2>{d.nom}</h2>
            {d.etapes.map((e) => (
              <article id={`e${e.annee}`}>
                <span class="an">{e.annee}</span>
                <div>
                  <h3>{e.titre}</h3>
                  <p>{e.texte}</p>
                  {e.photos.length > 0 && <div class="photos">{e.photos.map((p) => <a href={asset(p)} target="_blank"><img {...photo(p, '160px')} alt="" loading="lazy" /></a>)}</div>}
                </div>
              </article>
            ))}
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .dark h2 { color: #fff; } .dark .eyebrow { color: rgba(255,255,255,.75); }
  .forts { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; }
  .forts a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: #fff; }
  .forts img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 14px; margin-bottom: 8px; }
  .forts b { font-family: var(--font-title); font-size: 1.6rem; color: var(--ciel); line-height: 1; }
  .forts span { font-size: .9rem; color: rgba(255,255,255,.85); }
  .chap { display: grid; grid-template-columns: 230px 1fr; gap: 56px; align-items: start; }
  .sommaire { position: sticky; top: 110px; display: flex; flex-direction: column; gap: 4px; }
  .sommaire a { display: flex; gap: 12px; align-items: baseline; padding: 10px 14px; border-radius: 12px; text-decoration: none; color: var(--muted); font-size: .95rem; border-left: 3px solid transparent; }
  .sommaire a:hover { background: #fff; border-left-color: var(--rouge); color: var(--marine); }
  .sommaire b { font-family: var(--font-title); color: var(--marine); font-size: 1.05rem; min-width: 3em; }
  .bloc { scroll-margin-top: 100px; } .bloc + .bloc { margin-top: 36px; }
  .bloc > h2 { font-size: 1.8rem; padding-bottom: 12px; border-bottom: 3px solid var(--marine); margin-bottom: 8px; }
  article { display: grid; grid-template-columns: 110px 1fr; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 100px; }
  .an { font-family: var(--font-title); font-weight: 700; font-size: 1.4rem; color: var(--rouge); }
  article h3 { margin: 0 0 4px; font-size: 1.15rem; } article p { margin: 0; color: var(--muted); }
  .photos { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .photos img { width: 120px; height: 90px; object-fit: cover; border-radius: 10px; }
  @media (max-width: 899px) {
    .forts { grid-template-columns: repeat(3, 1fr); }
    .chap { grid-template-columns: 1fr; gap: 20px; }
    .sommaire { position: static; flex-direction: row; flex-wrap: wrap; } .sommaire .eyebrow { width: 100%; } .sommaire a { padding: 8px 12px; border: 1px solid var(--line); }
    article { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
