---
import { photo, photoUrl } from '../lib/photo';
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import club from '../data/club.json';
import pages from '../data/pages.json';
import t from '../data/tarifs.json';
import { url, asset, dateFr } from '../lib/utils';

const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const annees = new Date().getFullYear() - 1979;
const pg = pages.accueil;
const hero = pg.diaporama[0];
const nf = (x: number) => x.toLocaleString('fr-FR');
const des = Math.min(...t.formules.flatMap((x) => x.prix.map((p) => p.prix)));
// L'accueil est un sommaire : une case par rubrique, qui renvoie vers sa page.
// Le détail (prix, simulateur, fiches avions) ne figure que sur la page concernée.
const rubriques = [
  { titre: "Baptême de l'air", texte: pg.bapteme.texte, fait: `Dès ${nf(des)} €`, href: '/decouvrir-le-vol', image: pg.bapteme.image },
  { titre: 'Devenir pilote', texte: pg.formation.texte, fait: 'Votre budget en une minute', href: '/formations', image: pg.formation.image },
  { titre: 'La flotte', texte: pages.flotte.texte, fait: `${avions.length} avions`, href: '/club/flotte', image: pages.flotte.image },
  { titre: 'Le club', texte: pages.club.texte.replace('{fondation}', club.fondation), fait: 'Depuis 1979', href: '/club', image: pages.club.image },
];
const actus = (await getCollection('actualites', (a) => a.data.publie)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
const fleche = '<svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M2 9h13M10 4l5 5-5 5"/></svg>';
---
<Base title="Accueil">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SportsClub', name: club.nom, alternateName: club.sigle,
    url: new URL(url('/'), Astro.site).href, telephone: club.telephone, email: club.email, foundingDate: '1979',
    image: new URL(asset('/partage.jpg'), Astro.site).href, sameAs: [club.facebook],
    address: { '@type': 'PostalAddress', streetAddress: 'Aéroport de Beauvais-Tillé, zone aéroplaisance', postalCode: '60000', addressLocality: 'Tillé', addressCountry: 'FR' },
    geo: { '@type': 'GeoCoordinates', latitude: club.latitude, longitude: club.longitude },
  })} />

  <section class="hero" aria-label="Présentation">
    <div class="h-img"><img {...photo(hero?.image, '100vw')} fetchpriority="high" alt={hero?.legende ?? ''} />
      {pg.video && (
        <video class="h-video" autoplay muted loop playsinline preload="metadata" poster={photoUrl(hero?.image)} aria-hidden="true">
          <source src={asset(pg.video)} type="video/mp4" />
        </video>
      )}</div>
    <div class="h-panneau" data-reveal>
      <div class="label">Aéroclub associatif depuis 1979</div>
      <h1 data-split="now">{pg.titre}.</h1>
      <p>{pg.texte.replace('{annees}', String(annees))}</p>
      <div class="h-btns">
        <a class="btn btn-primary" href={url('/contact?objet=Baptême')}>Réserver un baptême</a>
        <a class="btn btn-nuit" href={url('/formations')}>Devenir pilote</a>
      </div>
    </div>
  </section>

  <section class="plan" aria-label="Sommaire du site">
    <div class="container">
      <div class="label">Au sommaire</div>
      <div class="cases" data-stagger>
        {rubriques.map((r, i) => (
          <a class="case" href={url(r.href)}>
            <div class="c-photo"><img {...photo(r.image, '(min-width: 900px) 25vw, 100vw')} alt="" loading="lazy" /></div>
            <div class="c-corps">
              <span class="c-fait">{r.fait}</span>
              <h2>{r.titre}</h2>
              <p>{r.texte}</p>
              <span class="c-lien">Voir la page <i set:html={fleche} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <div class="label">Le club</div>
      <h2 data-split class="c-titre">{pg.atouts_titre}.</h2>
      <div class="chiffres" data-stagger>
        {pg.atouts.map((a) => {
          const v = a.chiffre.replace('{avions}', String(avions.length));
          const m = v.match(/^(\d+)\s*(%?)$/);
          return (
            <div>
              <strong {...(m ? { 'data-count': m[1], 'data-suffix': m[2] ? ' %' : undefined, 'data-from': +m[1] > 1000 ? String(+m[1] - 80) : undefined } : {})}>{v}</strong>
              <span>{a.texte}{a.lien && <> <a href={url(a.lien)}>{a.lien_texte || 'En savoir plus'}</a></>}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section journal">
    <div class="container">
      <div class="tete">
        <div><div class="label">La vie du club</div><h2 data-split>Dernières nouvelles.</h2></div>
        <a class="btn btn-outline" href={url('/actualites')}>Toutes les actualités</a>
      </div>
      <ol class="j-liste" data-stagger>
        {actus.map((a) => (
          <li><a href={url(`/actualites/${a.id}`)}><span class="j-date">{dateFr(a.data.date, { day: 'numeric', month: 'long', year: 'numeric' })}</span><span class="j-titre">{a.data.titre}</span><i set:html={fleche} /></a></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="venir">
    <div class="container v-in">
      <div><div class="label">Aéroport de Beauvais-Tillé</div><h2 data-split>On vous attend au terrain.</h2><p>{club.adresse}</p></div>
      <div class="btns">
        <a class="btn btn-primary" href={url('/contact?objet=Baptême')}>Réserver un baptême</a>
        <a class="btn btn-outline" href={url('/contact')}>Nous contacter</a>
      </div>
    </div>
  </section>
</Base>



<script>
  // Vidéo de fond : coupée si le visiteur a demandé moins d'animations
  const v = document.querySelector<HTMLVideoElement>('.h-video');
  if (v && matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); }
</script>

<style>
  /* Ouverture : photo, panneau blanc qui chevauche */
  .hero { position: relative; background: var(--nuit); }
  .h-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .h-img { position: relative; }
  .h-img { height: clamp(440px, 56vw, 720px); overflow: hidden; }
  .h-img img { width: 100%; height: 100%; object-fit: cover; object-position: 40% 60%; }
  .h-chiffre { position: absolute; right: clamp(16px, 4vw, 64px); bottom: 28px; color: #fff; text-align: right; font-family: var(--font-title); font-stretch: 80%; text-shadow: 0 2px 20px rgba(10,26,58,.35); }
  .h-chiffre strong { display: block; font-size: clamp(56px, 7vw, 110px); font-weight: 800; line-height: .9; }
  .h-chiffre span { font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
  .h-panneau { position: absolute; left: max(clamp(16px, 4vw, 64px), (100% - var(--max)) / 2 + clamp(16px, 4vw, 64px)); bottom: clamp(-60px, -4vw, -30px); width: min(640px, 100% - 2 * clamp(16px, 4vw, 64px)); background: var(--white); padding: clamp(28px, 3.4vw, 48px); box-shadow: 0 30px 60px -30px rgba(10,26,58,.35); }
  .h-panneau h1 { font-size: clamp(2.6rem, 5.2vw, 4.8rem); margin: 6px 0 18px; }
  .h-panneau p { color: var(--muted); font-size: 1.08rem; max-width: 46ch; margin-bottom: 26px; }
  .h-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  /* Sommaire : quatre cases, photo numérotée, trait jaune au survol */
  .plan { padding: clamp(110px, 9vw, 140px) 0 clamp(56px, 7vw, 96px); }
  .cases { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .case { position: relative; display: flex; flex-direction: column; background: var(--paper-2); color: inherit; text-decoration: none; overflow: hidden; }
  .case::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--sun); transform: scaleX(0); transform-origin: left; transition: transform .35s; }
  .case:hover::after { transform: scaleX(1); }
  .c-photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .c-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .case:hover .c-photo img { transform: scale(1.05); }
  .c-corps { display: flex; flex-direction: column; flex: 1; padding: 20px 22px 24px; }
  .c-fait { font-family: var(--font-title); font-stretch: 90%; font-size: .74rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .case h2 { font-size: clamp(1.6rem, 2.2vw, 2.1rem); margin: 8px 0 10px; }
  .c-corps p { color: var(--muted); font-size: .95rem; margin: 0 0 18px; }
  .c-lien { margin-top: auto; display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-title); font-stretch: 90%; font-weight: 700; color: var(--ink); }
  .c-lien :global(svg), .j-liste :global(svg) { width: 15px; height: 15px; transition: transform .2s; }
  .case:hover .c-lien :global(svg) { transform: translateX(4px); }
  .case:focus-visible { outline: 3px solid var(--sun); outline-offset: 3px; }

  /* Dernières nouvelles */
  .j-liste { list-style: none; margin: 0; padding: 0; border-top: 3px solid var(--ink); }
  .j-liste a { display: grid; grid-template-columns: 13em 1fr auto; gap: 24px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .j-date { font-family: var(--font-title); font-stretch: 90%; font-size: .76rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .j-titre { font-family: var(--font-title); font-stretch: 85%; font-weight: 700; font-size: clamp(1.1rem, 1.8vw, 1.45rem); color: var(--ink); }
  .j-liste a:hover .j-titre { text-decoration: underline; text-decoration-color: var(--sun); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .j-liste a:hover :global(svg) { transform: translateX(4px); }

  /* Fin de page */
  .venir { background: var(--sun); padding: clamp(48px, 6vw, 80px) 0; }
  .v-in { display: flex; justify-content: space-between; align-items: flex-end; gap: 28px; flex-wrap: wrap; }
  .venir .label { color: var(--ink); }
  .venir .label::before { background: var(--ink); }
  .venir h2 { margin: 0 0 8px; }
  .venir p { margin: 0; color: var(--ink); }
  .venir .btn-primary { background: var(--ink); color: #fff; }
  .venir .btn-primary:hover { background: var(--ink-2); color: #fff; }

  /* Le club en chiffres */
  .c-titre { max-width: 16ch; margin-bottom: 40px; }
  .chiffres { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .chiffres > div { border-top: 3px solid var(--sun); padding-top: 18px; }
  .chiffres strong { display: block; font-family: var(--font-title); font-stretch: 80%; font-weight: 800; font-size: clamp(3.2rem, 6vw, 5.4rem); color: #fff; line-height: 1; font-variant-numeric: tabular-nums; }
  .chiffres span { display: block; margin-top: 8px; max-width: 32ch; font-size: .95rem; }

  @media (max-width: 980px) {
    .h-img { height: min(70vw, 460px); }
    .h-panneau { position: relative; left: auto; bottom: auto; width: auto; margin: -64px 12px 0; padding: 26px 22px; }
    .h-btns { grid-template-columns: 1fr; }
    .h-chiffre { top: 52px; bottom: auto; }
    .h-chiffre strong { font-size: 52px; }
    .plan { padding-top: 32px; }
    .tete { grid-template-columns: 1fr; margin-bottom: 28px; }
    .tete .btn { justify-self: start; }
    .chiffres { grid-template-columns: 1fr; }
    .cases { grid-template-columns: 1fr 1fr; }
    .j-liste a { grid-template-columns: 1fr; gap: 6px; }
    .j-liste a svg { display: none; }
  }
  @media (max-width: 600px) {
    .cases { grid-template-columns: 1fr; }
  }
</style>
