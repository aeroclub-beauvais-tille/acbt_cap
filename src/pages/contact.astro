---
import { cleFormulaire } from '../lib/utils';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import club from '../data/club.json';
import CartePlan from '../components/CartePlan.astro';
import pages from '../data/pages.json';
import t from '../data/tarifs.json';
import { url } from '../lib/utils';
const ico = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const telHref = `tel:${club.telephone.replace(/\s/g, '')}`;
const infos = [
  { titre: 'Téléphone', html: `<a href="${telHref}">${club.telephone}</a>`, svg: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/>' },
  { titre: 'E-mail', html: `<a href="mailto:${club.email}">${club.email}</a>`, svg: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>' },
  { titre: 'Adresse du club', html: club.adresse, svg: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>' },
  { titre: 'Horaires', html: club.horaires, svg: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>' },
  { titre: 'Accès', html: club.acces.map((l) => `<span class="acces">${l}</span>`).join(''), svg: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>' },
];
const liens = [
  { titre: "Baptême de l'air", texte: 'Formules et prix', href: '/decouvrir-le-vol', svg: '<path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/><circle cx="12" cy="12" r="10"/>' },
  { titre: 'Devenir pilote', texte: 'Le parcours, de la 1re leçon à la licence', href: '/formations', svg: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>' },
  { titre: 'Tarifs', texte: 'Heures de vol et adhésion', href: '/club/tarifs', svg: '<path d="M4 10h12"/><path d="M4 14h9"/><path d="M19 6a7.7 7.7 0 0 0-5.2-2A7.9 7.9 0 0 0 6 12c0 4.4 3.5 8 7.8 8 2 0 3.8-.8 5.2-2"/>' },
];
// Formules des vols découverte / initiation, reprises des tarifs (section Baptême de l'air du back-office).
const nf = (x: number) => x.toLocaleString('fr-FR');
const formules = t.formules.flatMap((f) => f.prix.map((p) => ({
  type: /d[ée]couverte/i.test(f.titre) ? 'Vol découverte' : "Vol d'initiation",
  texte: `${f.titre} · ${p.libelle} · ${nf(p.prix)} €`,
})));
---
<Base title="Contact" description="Contacter l'aéroclub de Beauvais-Tillé.">
  <PageHead eyebrow="Contact" image={pages.contact.image || undefined} title={pages.contact.titre} lead={pages.contact.texte} />
  <section class="section">
    <div class="container grid grid-2 c-grille">
      <div>
      <span class="eyebrow">Écrire au club</span>
      <h2>Envoyez-nous un message</h2>
      <form id="contact" class="card" data-reveal="left"><div class="card-body">
        <label>Nom et prénom<input name="nom" required /></label>
        <label>E-mail<input type="email" name="email" required /></label>
        <fieldset class="rappel">
          <legend>Comment préférez-vous être recontacté ?</legend>
          <div class="choix">
            <label><input type="radio" name="rappel" value="Par e-mail" checked /><span>Par e-mail</span></label>
            <label><input type="radio" name="rappel" value="Par téléphone" /><span>Par téléphone</span></label>
          </div>
        </fieldset>
        <label><span>Téléphone <span class="tel-facultatif">(facultatif)</span></span><input type="tel" name="tel" autocomplete="tel" /></label>
        <label>Objet
          <select name="objet">
            <option>Vol découverte</option><option>Vol d'initiation</option><option>Bon cadeau</option><option>Inscription</option><option>Autre question</option>
          </select>
        </label>
        <label class="si-vol">Formule
          <select name="formule">
            {formules.map((f) => <option data-type={f.type} value={f.texte}>{f.texte}</option>)}
          </select>
        </label>
        <label class="si-vol">Créneaux souhaités (plusieurs possibles)<input name="creneau" placeholder="Ex. : samedi 14/03 après-midi, dimanche 02/04 matin…" /></label>
        <label><span>Message <span class="facultatif">(facultatif)</span></span><textarea name="message" rows="5" required></textarea></label>
        <input type="checkbox" name="botcheck" class="piege" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn-primary" type="submit">Envoyer</button>
        <p class="meta envoi" role="status" aria-live="polite" style="margin-top:10px">{cleFormulaire(club.formulaire_cle) ? 'Votre message part directement au club, qui vous recontacte par e-mail ou par téléphone, comme vous le préférez.' : "Le message s'ouvre dans votre logiciel de messagerie."}</p>
      </div></form>
      </div>
      <div data-reveal="right" data-delay="0.15">
        <span class="eyebrow">ACBT</span>
        <h2>Nos informations pratiques</h2>
        <ul class="infos">
          {infos.map((i) => <li><i set:html={ico(i.svg)} /><div><b>{i.titre}</b><span set:html={i.html} /></div></li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="localisation">
        <div class="loc-txt">
          <span class="eyebrow">Nous trouver</span>
          <h2>{pages.contact.intertitres.carte}</h2>
          <p>Le club est dans la zone aéroplaisance de l'aéroport de Beauvais-Tillé.</p>
          <a class="btn btn-outline" href={`https://www.google.com/maps/dir/?api=1&destination=${club.latitude},${club.longitude}`} target="_blank" rel="noopener">Itinéraire</a>
        </div>
        <div class="carte-contact"><CartePlan hauteur="340px" /></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Infos utiles</span>
      <h2>Liens pratiques</h2>
      <div class="liens">
        {liens.map((l) => <a href={url(l.href)}><i set:html={ico(l.svg)} /><span><b>{l.titre}</b>{l.texte}</span><em aria-hidden="true">→</em></a>)}
      </div>
    </div>
  </section>
</Base>
<script define:vars={{ email: club.email, cle: cleFormulaire(club.formulaire_cle) }}>
  // Envoi direct depuis le site (service Web3Forms, qui transmet le message à l'adresse du club).
  // Sans clé réglée dans le back-office, on ouvre la messagerie du visiteur comme avant.
  const form = document.getElementById('contact');
  const etat = form.querySelector('.envoi');
  const bouton = form.querySelector('button[type=submit]');
  // Les anciens liens « Baptême » ouvrent le vol découverte.
  const brut = new URLSearchParams(location.search).get('objet');
  const objet = brut === 'Baptême' ? 'Vol découverte' : brut;
  if (objet) form.objet.value = objet;
  // Vol découverte / initiation : on propose les formules de ce vol et le créneau souhaité.
  // Bon cadeau : toutes les formules, sans créneau.
  const options = [...form.formule.options];
  const majObjet = () => {
    const o = form.objet.value;
    const vol = o === 'Vol découverte' || o === "Vol d'initiation";
    const cadeau = o === 'Bon cadeau';
    form.querySelectorAll('.si-vol').forEach((el) => { el.hidden = !(vol || (cadeau && el.contains(form.formule))); });
    // Liste refaite à chaque choix (iPhone ignore les options masquées)
    const avant = form.formule.value;
    form.formule.replaceChildren(...options.filter((op) => !vol || op.dataset.type === o));
    if ([...form.formule.options].some((op) => op.value === avant)) form.formule.value = avant;
    form.message.required = !(vol || cadeau);
    form.querySelector('.facultatif').hidden = form.message.required;
  };
  form.objet.addEventListener('change', majObjet);
  majObjet();
  // Rappel par téléphone : le numéro devient obligatoire (l'e-mail l'est toujours).
  const majRappel = () => {
    const tel = form.rappel.value === 'Par téléphone';
    form.tel.required = tel;
    form.querySelector('.tel-facultatif').hidden = tel;
  };
  form.querySelectorAll('input[name=rappel]').forEach((r) => r.addEventListener('change', majRappel));
  majRappel();
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const visible = (n) => !form[n].closest('label').hidden;
    const detail = () => [visible('formule') && `Formule : ${f.get('formule')}`, visible('creneau') && f.get('creneau') && `Créneaux souhaités : ${f.get('creneau')}`].filter(Boolean).map((x) => x + '\n').join('') + (visible('formule') ? '\n' : '');
    if (!cle) {
      const body = `${detail()}${f.get('message')}\n\n${f.get('nom')}\n${f.get('email')}\n${f.get('tel') || ''}\nÀ recontacter : ${f.get('rappel')}`;
      location.href = `mailto:${email}?subject=${encodeURIComponent('[Site] ' + f.get('objet'))}&body=${encodeURIComponent(body)}`;
      return;
    }
    if (f.get('botcheck')) return; // robot
    bouton.disabled = true;
    etat.dataset.etat = '';
    etat.textContent = 'Envoi en cours…';
    try {
      const r = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: cle,
          subject: `[Site ACBT] ${f.get('objet')} – ${f.get('nom')}`,
          from_name: 'Site de l’ACBT',
          replyto: f.get('email'),
          'Nom': f.get('nom'), 'E-mail': f.get('email'), 'Téléphone': f.get('tel') || '—', 'À recontacter': f.get('rappel'), 'Objet': f.get('objet'),
          ...(visible('formule') ? { 'Formule': f.get('formule') } : {}),
          ...(visible('creneau') ? { 'Créneaux souhaités': f.get('creneau') || '—' } : {}),
          'Message': f.get('message') || '—',
        }),
      });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || j.success === false) throw new Error(j.message || 'Erreur');
      const parTel = f.get('rappel') === 'Par téléphone';
      form.reset();
      if (objet) form.objet.value = objet;
      majObjet();
      majRappel();
      etat.dataset.etat = 'ok';
      etat.textContent = parTel ? 'Merci, votre message est bien parti. Le club vous rappelle au numéro indiqué.' : 'Merci, votre message est bien parti. Le club vous répond par e-mail.';
    } catch {
      etat.dataset.etat = 'ko';
      etat.innerHTML = `Le message n'a pas pu partir. Réessayez, ou écrivez à <a href="mailto:${email}">${email}</a>.`;
    } finally {
      bouton.disabled = false;
    }
  });
</script>
<style>
  .formulaire label[hidden], .facultatif[hidden], .tel-facultatif[hidden] { display: none; }
  .facultatif, .tel-facultatif { font-weight: 400; color: var(--muted); }
  /* Choix du rappel : deux boutons côte à côte, pas de ronds natifs */
  .rappel { border: 0; padding: 0; margin: 0 0 14px; min-width: 0; }
  .rappel legend { font-weight: 600; font-size: .92rem; margin-bottom: 6px; padding: 0; }
  .choix { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .choix label { margin: 0; position: relative; }
  .choix input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .choix span { display: block; text-align: center; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font-weight: 500; transition: background .2s, border-color .2s, color .2s; }
  .choix input:checked + span { background: var(--accent-fonce); border-color: var(--accent-fonce); color: #fff; }
  .choix input:focus-visible + span { outline: 2px solid var(--sun, #f5b800); outline-offset: 2px; }
  .piege { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .envoi[data-etat='ok'] { color: #1d8a4e; font-weight: 600; }
  .envoi[data-etat='ko'] { color: #b3261e; font-weight: 600; }
  .carte-contact { height: 340px; }
  .c-grille { gap: clamp(28px, 5vw, 72px); align-items: start; }
  .c-grille h2 { margin-bottom: 22px; }
  .infos { list-style: none; margin: 0; padding: 0; }
  .infos li { display: flex; gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .infos li:first-child { padding-top: 4px; }
  .infos li:last-child { border-bottom: 0; }
  .infos i, .liens i { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; border: 1px solid var(--line); color: var(--marine); }
  .infos i :global(svg), .liens i :global(svg) { width: 24px; height: 24px; }
  .infos b { display: block; font-family: var(--font-title); font-size: 1.1rem; color: var(--ink); }
  .infos span { color: var(--muted); }
  .infos :global(.acces) { display: block; }
  .infos :global(.acces)::before { content: '· '; }
  .localisation { display: grid; grid-template-columns: 1fr 1.6fr; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }
  .loc-txt { padding: clamp(24px, 4vw, 48px); align-self: center; }
  .loc-txt p { color: var(--muted); }
  .localisation .carte-contact { height: 100%; min-height: 340px; }
  @media (max-width: 799px) { .localisation { grid-template-columns: 1fr; } }
  .liens { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .liens a { display: flex; align-items: center; gap: 16px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 16px; text-decoration: none; color: var(--muted); font-size: .9rem; transition: border-color .2s, transform .2s; }
  .liens a:hover { border-color: var(--marine); transform: translateY(-2px); }
  .liens b { display: block; font-family: var(--font-title); font-size: 1.1rem; color: var(--ink); }
  .liens em { margin-left: auto; font-style: normal; color: var(--marine); font-size: 1.2rem; }
  @media (max-width: 799px) { .liens { grid-template-columns: 1fr; } }
  .grid-2 > * { min-width: 0; }
  label { display: flex; flex-direction: column; gap: 4px; font-weight: 600; font-size: .92rem; margin-bottom: 14px; }
  input, select, textarea { font: inherit; font-weight: 400; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; }
</style>
