---
// Page Baptême (proposition B choisie par Hugo le 25/11) : les trois formules côte à côte comme une grille de prix,
// puis le jour J à côté d'une grande photo, puis les questions. Tout vient du back-office (Tarifs, Page Découvrir).
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Faq from '../components/Faq.astro';
import pages from '../data/pages.json';
import d from '../data/decouvrir.json';
import { photo } from '../lib/photo';
import { url } from '../lib/utils';
import { n, passager, commandes, des, photoCommandes, etapes, questions, svg, ico, pictosEtapes, tel, telHref } from '../lib/bapteme';
const cols = [
  { mode: 'En passager', icone: svg.oeil, titre: passager.titre, texte: passager.texte, prix: des, des: true, objet: 'Vol découverte', details: passager.prix },
  ...commandes.map((f, i) => ({ mode: 'Aux commandes', icone: svg.volant, titre: f.titre, texte: f.texte, prix: f.prix[0].prix, des: false, objet: "Vol d'initiation", details: [] as { libelle: string; prix: number }[], fort: i === 0 })),
];
---
<Base univers="decouvrir" title="Baptême de l'air" description={`Baptême de l'air, vol découverte et vol d'initiation à Beauvais-Tillé, dès ${n(des)} €.`}>
  <PageHead eyebrow="Baptême de l'air" image={pages.decouvrir.image} title={pages.decouvrir.titre} lead={d.accroche}>
    <div class="btns" style="margin-top:22px"><a class="btn btn-jaune" href={url('/contact?objet=Vol découverte')}>Réserver un baptême</a></div>
  </PageHead>

  <section class="section">
    <div class="container">
      <div class="tete">
        <div><span class="eyebrow">Nos formules</span><h2>Choisissez votre vol</h2></div>
        <p>Toutes les formules existent en <a href={url('/contact?objet=Bon cadeau')}>bon cadeau</a>. Règlement par virement, chèque ou espèces.</p>
      </div>
      <div class="grille">
        {cols.map((c: any) => (
          <article class:list={['col', { fort: c.fort }]}>
            <span class="mode"><Fragment set:html={ico(c.icone)} /> {c.mode}</span>
            <h3>{c.titre}</h3>
            <p class="prix">{c.des && <small>dès</small>}<b>{n(c.prix)}</b> €</p>
            <p class="txt">{c.texte}</p>
            {c.details.length > 0 && <ul>{c.details.map((p: any) => <li><span>{p.libelle}</span><b>{n(p.prix)} €</b></li>)}</ul>}
            <a class="btn btn-jaune" href={url(`/contact?objet=${c.objet}`)}>Réserver</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container jour">
      <div class="j-photo"><img {...photo(photoCommandes, '(min-width: 900px) 600px, 100vw')} alt="" loading="lazy" /></div>
      <div>
        <span class="eyebrow">Le jour J</span>
        <h2>{d.deroulement_titre}</h2>
        <ol class="fil">
          {etapes.map((e, i) => <li><i set:html={ico(pictosEtapes[i % 4])} /><div><h3>{e.titre}</h3><p>{e.texte}</p></div></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Questions fréquentes</span>
      <h2>Bon à savoir</h2>
      <Faq questions={questions} />
    </div>
  </section>
  <div class="barre-mobile">
    <a class="btn btn-jaune" href={url('/contact?objet=Vol découverte')}>Réserver un baptême</a>
    <a class="btn btn-outline" href={telHref} aria-label={`Appeler le ${tel}`}>Appeler</a>
  </div>
</Base>
<script>
  // Téléphone : la barre Réserver / Appeler n'arrive qu'une fois le bandeau du haut sorti de l'écran
  const barre = document.querySelector('.barre-mobile');
  const tete = document.querySelector('.page-head');
  if (barre && tete && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => barre.classList.toggle('visible', !e.isIntersecting)).observe(tete);
  } else barre?.classList.add('visible');
</script>
<style>
  .barre-mobile { display: none; }
  @media (max-width: 899px) {
    .barre-mobile { position: sticky; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.94); backdrop-filter: blur(10px); border-top: 1px solid var(--line); transition: transform .3s ease, opacity .3s ease; }
    .barre-mobile .btn { justify-content: center; padding: 12px 16px; }
    .barre-mobile:not(.visible) { transform: translateY(110%); opacity: 0; pointer-events: none; }
  }
  .tete { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
  .tete h2 { margin: 0; }
  .tete p { max-width: 42ch; color: var(--muted); margin: 0; }
  .grille { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
  .col { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 22px; padding: 28px; background: #fff; }
  .col.fort { border: 2px solid var(--marine); }
  .mode { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ciel); }
  .mode :global(svg) { width: 18px; height: 18px; }
  .col h3 { font-size: 1.5rem; margin: 12px 0 6px; }
  .prix { margin: 0 0 12px; font-family: var(--font-title); color: var(--marine); font-size: 1.4rem; }
  .prix b { font-size: 3.4rem; line-height: 1; letter-spacing: -.03em; }
  .prix small { font-size: .95rem; color: var(--muted); margin-right: 6px; font-family: var(--font-body); }
  .txt { color: var(--muted); font-size: .95rem; }
  .col ul { list-style: none; margin: 0 0 8px; padding: 0; border-top: 1px solid var(--line); }
  .col li { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: .95rem; }
  .col li b { font-family: var(--font-title); color: var(--marine); }
  .col .btn { margin-top: auto; justify-content: center; }
  .col > p.txt + .btn, .col ul + .btn { margin-top: auto; }
  .jour { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .j-photo { border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5; }
  .j-photo img { width: 100%; height: 100%; object-fit: cover; }
  .jour h2 { color: #fff; } .jour .eyebrow { color: rgba(255,255,255,.75); }
  .fil { list-style: none; margin: 24px 0 0; padding: 0; color: #fff; }
  .fil li { position: relative; display: flex; gap: 20px; padding-bottom: 26px; }
  .fil li:not(:last-child)::before { content: ''; position: absolute; left: 25px; top: 54px; bottom: 4px; width: 2px; background: rgba(255,255,255,.25); }
  .fil i { flex: none; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #fff; color: var(--marine); }
  .fil li:first-child i { background: var(--rouge); color: #fff; }
  .fil i :global(svg) { width: 24px; height: 24px; }
  .fil h3 { color: #fff; font-size: 1.2rem; margin: 4px 0 4px; }
  .fil p { color: rgba(255,255,255,.8); margin: 0; font-size: .96rem; }
  @media (max-width: 899px) { .grille, .jour { grid-template-columns: 1fr; } .j-photo { aspect-ratio: 16 / 9; } }
</style>
