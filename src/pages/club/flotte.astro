---
import { photo, photoUrl } from '../../lib/photo';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { asset, url } from '../../lib/utils';
const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
import pages from '../../data/pages.json';
---
<Base univers="voler" title="La flotte" description="Les avions de l'aéroclub de Beauvais-Tillé : Robin DR400, DR300 et Jodel D120.">
  <PageHead eyebrow="Notre flotte" image={pages.flotte.image} title={pages.flotte.titre.replace('{nombre}', String(avions.length))} lead={pages.flotte.texte} />
  <section class="flotte" aria-label="Les avions">
    {avions.map((a, i) => (
      <article class="avion" id={a.id}>
        <div class="a-tete">
          <span class="a-num">{String(i + 1).padStart(2, '0')} / {String(avions.length).padStart(2, '0')}</span>
          {a.data.usage && <span class="a-usage">{a.data.usage}</span>}
        </div>
        {a.data.immatriculation && <p class="immat" data-split aria-hidden="true">{a.data.immatriculation}</p>}
        <div class="a-grille">
          <div class="a-photo" data-clip>
            {a.data.photos[0] && <img {...photo(a.data.photos[0], '(min-width: 900px) 60vw, 100vw')} alt={a.data.nom} loading={i < 2 ? 'eager' : 'lazy'} />}
          </div>
          <div class="a-infos">
            <h2 data-sans-italique>{a.data.nom}</h2>
            <dl class="fiche">
              {a.data.immatriculation && <div><dt>Immatriculation</dt><dd>{a.data.immatriculation}</dd></div>}
              {a.data.puissance && <div><dt>Puissance</dt><dd>{a.data.puissance} ch</dd></div>}
              {a.data.places && <div><dt>Places</dt><dd>{a.data.places}</dd></div>}
            </dl>
            {a.data.description && <p class="desc">{a.data.description}</p>}
            {a.data.photos.length > 1 && (
              <div class="vignettes">
                {a.data.photos.slice(1, 4).map((p) => <a href={asset(p)} target="_blank" aria-label={`Photo de ${a.data.nom}`}><img {...photo(p, '200px')} alt="" loading="lazy" /></a>)}
              </div>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>
  <section class="section">
    <div class="container" style="text-align:center">
      <h2 data-split>Envie de voler avec nous ?</h2>
      <a class="btn btn-primary" data-reveal="scale" href={url('/club/tarifs')}>Voir les tarifs</a>
    </div>
  </section>
</Base>
<style>
  /* Fiche technique par avion : bandeau bleu nuit avec l'immatriculation, grande photo, caractéristiques en tableau */
  .flotte { padding: clamp(32px, 5vw, 64px) 0; display: grid; gap: clamp(28px, 4vw, 48px); }
  .avion { width: min(var(--max), 100% - 2 * clamp(16px, 4vw, 64px)); margin: 0 auto; background: var(--white); border-top: 3px solid var(--sun); box-shadow: 0 0 0 1px var(--line); scroll-margin-top: 120px; }
  .a-tete { display: flex; justify-content: space-between; gap: 16px; padding: 12px clamp(18px, 3vw, 32px); background: var(--nuit); color: #a7b3ca; font-family: var(--font-title); font-stretch: 90%; font-size: .76rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .a-num { color: var(--sun); white-space: nowrap; }
  .a-usage { text-align: right; }
  .immat { font-family: var(--font-title); font-stretch: 75%; font-weight: 800; font-size: clamp(3.6rem, 11vw, 9rem); letter-spacing: -.02em; line-height: .9; color: var(--ink); margin: 0; padding: clamp(18px, 3vw, 32px) clamp(18px, 3vw, 32px) 0; white-space: nowrap; }
  .a-grille { display: grid; gap: clamp(20px, 3vw, 40px); grid-template-columns: 1.4fr 1fr; align-items: start; padding: clamp(18px, 3vw, 32px); }
  .a-photo { aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); }
  .a-photo img { width: 100%; height: 100%; object-fit: cover; }
  .a-infos h2 { font-size: clamp(1.7rem, 2.8vw, 2.4rem); margin: 0 0 18px; }
  .fiche { margin: 0 0 20px; border-top: 2px solid var(--ink); }
  .fiche div { display: flex; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .fiche dt { font-family: var(--font-title); font-stretch: 90%; font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .fiche dd { margin: 0; font-family: var(--font-title); font-stretch: 85%; font-weight: 750; font-size: 1.1rem; color: var(--ink); text-align: right; }
  .desc { color: var(--muted); max-width: 46ch; }
  .vignettes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 20px; }
  .vignettes a { display: block; overflow: hidden; }
  .vignettes img { aspect-ratio: 1; width: 100%; object-fit: cover; transition: transform .6s; }
  .vignettes a:hover img { transform: scale(1.06); }
  @media (max-width: 899px) { .a-grille { grid-template-columns: 1fr; } }
  /* Téléphone : un avion par écran, le défilement s'arrête sur chacun */
  @media (max-width: 599px) {
    :global(html) { scroll-snap-type: y proximity; }
    .flotte { gap: 18px; padding-top: 20px; }
    .avion { scroll-snap-align: start; scroll-margin-top: 112px; }
    .immat { font-size: 19vw; padding: 14px 16px 0; }
    .a-grille { padding: 14px 16px 18px; gap: 14px; }
    .a-infos h2 { font-size: 1.6rem; margin-bottom: 12px; }
    .fiche div { padding: 8px 0; }
    .desc { font-size: .95rem; margin-bottom: 0; }
    .vignettes { margin-top: 14px; }
  }
</style>
