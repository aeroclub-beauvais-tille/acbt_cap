---
import { photo, photoUrl } from '../../lib/photo';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import h from '../../data/historique.json';
import { asset } from '../../lib/utils';
import pages from '../../data/pages.json';
---
<Base univers="club" title="Notre histoire" description="L'histoire de l'aéroclub de Beauvais-Tillé depuis 1979.">
  <PageHead eyebrow="Le club" image={pages.historique.image} title={pages.historique.titre} lead={h.intro} />
  <section class="section">
    <div class="container">
      <ol class="frise">
        {h.etapes.map((e) => (
          <li data-reveal>
            <span class="annee">{e.annee}</span>
            <div class="contenu">
              <h2 data-sans-italique>{e.titre}</h2>
              <p>{e.texte}</p>
              {e.photos.length > 0 && (
                <div class="gallery" data-stagger>{e.photos.map((p) => <a href={asset(p)} target="_blank"><img {...photo(p, '(min-width: 700px) 25vw, 50vw')} alt={`${e.titre}, ${e.annee}`} loading="lazy" /></a>)}</div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<style>
  /* Frise : années en très grand dans la marge, trait jaune, une ligne par époque */
  .frise { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); }
  .frise li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr); gap: clamp(20px, 5vw, 72px); padding: clamp(26px, 4vw, 48px) 0; border-bottom: 1px solid var(--line); }
  .annee { align-self: start; font-family: var(--font-title); font-stretch: 75%; font-weight: 800; font-size: clamp(3rem, 7vw, 6rem); line-height: .85; color: var(--ink); padding-top: 12px; border-top: 3px solid var(--sun); }
  .contenu { max-width: 760px; }
  .contenu h2 { font-size: clamp(1.5rem, 2.6vw, 2.2rem); margin-bottom: .45em; }
  .contenu p { color: var(--muted); }
  .gallery { margin-top: 18px; }
  @media (max-width: 640px) { .frise li { grid-template-columns: 1fr; gap: 12px; } .annee { font-size: 3.4rem; justify-self: start; } }
</style>
