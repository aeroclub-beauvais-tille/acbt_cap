---
import club from '../data/club.json';
import { url } from '../lib/utils';
import Metar from './Metar.astro';
const nav = [
  { label: 'Baptême de l\'air', href: '/decouvrir-le-vol' },
  { label: 'Devenir pilote', href: '/formations' },
  { label: 'Tarifs', href: '/club/tarifs' },
  { label: 'Le club', href: '/club' },
  { label: 'Contact', href: '/contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const actif = (href: string) =>
  href === '/club' ? [url('/club'), url('/club/flotte'), url('/club/historique'), url('/actualites')].some((p) => path === p || path.startsWith(p + '/')) : path.startsWith(url(href));
const membre = path.startsWith(url('/membre'));
---
<header class="site-header">
  <div class="bandeau"><div class="container b-in"><Metar sombre bandeau /><a class="b-tel" href={`tel:${club.telephone.replace(/\s/g, '')}`}>{club.telephone}</a></div></div>
  <div class="container bar">
    <a class="logo" href={url('/')}>
      <img src={url('/uploads/logo/logo-acbt.png')} alt="" width="50" height="36" />
      <span><strong>ACBT</strong><small>Aéroclub de Beauvais-Tillé</small></span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Ouvrir le menu" />
    <nav aria-label="Navigation principale">
      <ul>
        {nav.map((n) => <li><a href={url(n.href)} aria-current={actif(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li class="li-membre"><a class="member" href={url('/membre')}>Espace membre</a></li>
      </ul>
    </nav>
    {Astro.slots.has('actions') && <div class="actions"><slot name="actions" /></div>}
    {!membre && <a class="reserver" href={url('/contact?objet=Baptême')}>Réserver<span>&nbsp;un vol</span></a>}
    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span></label>
  </div>
  <div class="progression" aria-hidden="true"></div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--white); border-bottom: 1px solid var(--line); transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  /* L'en-tête reste toujours visible : le bandeau METAR est fixe en haut. */
  .site-header.cache { transform: none; }
  .progression { position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--sun); transform: scaleX(0); transform-origin: left; pointer-events: none; }
  .bandeau { background: var(--nuit); color: #c9d2e3; font-size: .8rem; }
  .b-in { display: flex; justify-content: space-between; align-items: center; height: 32px; gap: 16px; }
  .bandeau a { color: #fff; font-weight: 600; text-decoration: none; }
  .bar { display: flex; align-items: center; gap: 8px; height: 72px; }
  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; margin-right: auto; }
  .logo img { height: 36px; width: auto; }
  .logo span { display: flex; flex-direction: column; line-height: 1; }
  .logo strong { font-family: var(--font-title); font-stretch: 85%; font-weight: 800; font-size: 1.4rem; color: var(--ink); }
  .logo small { font-size: .74rem; font-weight: 500; color: var(--muted); margin-top: 3px; }
  nav { align-self: stretch; }
  nav ul { display: flex; height: 100%; list-style: none; margin: 0; padding: 0; }
  nav li { display: flex; }
  nav a { display: flex; align-items: center; padding: 0 16px; color: var(--text); text-decoration: none; font-weight: 500; font-size: .95rem; white-space: nowrap; box-shadow: inset 0 -3px 0 transparent; transition: box-shadow .2s; }
  nav a:hover { color: var(--ink); box-shadow: inset 0 -3px 0 var(--line); }
  nav a[aria-current] { color: var(--ink); font-weight: 600; box-shadow: inset 0 -3px 0 var(--sun); }
  nav a.member { margin: 14px 0 14px 10px; padding: 0 16px; box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink); font-weight: 600; font-size: .9rem; }
  nav a.member:hover { background: var(--ink); color: #fff; }
  .nav-toggle { position: absolute; opacity: 0; pointer-events: none; }
  .reserver { margin-left: 8px; display: inline-flex; align-items: center; height: 44px; padding: 0 18px; background: var(--sun); color: var(--ink); font-family: var(--font-title); font-stretch: 90%; font-weight: 700; font-size: .95rem; text-decoration: none; white-space: nowrap; transition: background-color .2s; }
  .reserver:hover { background: #ffcb33; color: var(--ink); }
  .reserver:focus-visible, nav a:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }
  .actions { display: flex; align-items: center; margin-left: 8px; }
  .burger { display: none; width: 44px; height: 44px; background: var(--paper-2); align-items: center; justify-content: center; cursor: pointer; position: relative; z-index: 2; }
  .burger span, .burger span::before, .burger span::after { display: block; width: 18px; height: 2px; background: var(--ink); transition: transform .25s, background-color .2s; }
  .burger span { position: relative; }
  .burger span::before, .burger span::after { content: ''; position: absolute; left: 0; }
  .burger span::before { top: -6px; } .burger span::after { top: 6px; }
  @media (max-width: 1180px) { .reserver span { display: none; } nav a { padding: 0 11px; } }
  @media (max-width: 980px) {
    .burger { display: inline-flex; margin-left: 6px; }
    .b-tel { display: none; }
    nav { position: fixed; inset: 0; z-index: 1; background: var(--nuit); display: none; padding: 120px 20px 40px; overflow-y: auto; }
    nav ul { flex-direction: column; height: auto; }
    nav a { color: #fff; font-family: var(--font-title); font-stretch: 82%; font-weight: 750; font-size: clamp(1.9rem, 8vw, 2.6rem); padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.12); box-shadow: none !important; }
    nav a:hover { color: #fff; }
    nav a[aria-current] { color: var(--sun); }
    nav a.member { margin: 24px 0 0; font-size: 1.05rem; font-family: var(--font-body); font-weight: 600; color: var(--sun); border: 0; }
    nav a.member:hover { background: none; color: var(--sun); }
    .nav-toggle:checked ~ nav { display: block; animation: menu-in .3s ease-out; }
    .nav-toggle:checked ~ .burger { background: var(--sun); }
    .nav-toggle:checked ~ .burger span { background: transparent; }
    .nav-toggle:checked ~ .burger span::before { transform: translateY(6px) rotate(45deg); }
    .nav-toggle:checked ~ .burger span::after { transform: translateY(-6px) rotate(-45deg); }
    .nav-toggle:focus-visible ~ .burger { outline: 3px solid var(--sun); outline-offset: 2px; }
  }
  @media (max-width: 440px) { .logo small { display: none; } .bar { height: 64px; } }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .nav-toggle:checked ~ nav { animation: none; } }
</style>
