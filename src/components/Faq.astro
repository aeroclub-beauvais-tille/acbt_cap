---
// Questions fréquentes en accordéon, avec les données structurées pour les moteurs de recherche.
interface Props { questions: { question: string; reponse: string }[] }
const { questions } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: questions.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.reponse } })) };
---
<div class="faq" data-stagger>
  {questions.map((q) => (
    <details>
      <summary>{q.question}<span aria-hidden="true">+</span></summary>
      <p>{q.reponse}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style>
  /* Questions en lignes nettes : trait épais en tête, carré jaune qui se change en croix */
  .faq { max-width: 900px; margin-top: clamp(24px, 3vw, 40px); border-top: 3px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 18px 0; font-family: var(--font-title); font-stretch: 88%; font-weight: 700; font-size: clamp(1.05rem, 1.8vw, 1.25rem); color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  summary span { flex: none; display: grid; place-items: center; width: 32px; height: 32px; background: var(--sun); color: var(--ink); font-size: 1.3rem; font-weight: 700; transition: transform .25s, background-color .2s; }
  details[open] summary span { transform: rotate(45deg); background: var(--ink); color: #fff; }
  p { margin: 0; padding: 0 52px 20px 0; color: var(--muted); max-width: 68ch; }
</style>
