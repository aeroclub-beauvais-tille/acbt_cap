---
// Étapes numérotées (déroulement d'un vol, parcours de formation).
interface Props { etapes: { titre: string; texte: string }[] }
const { etapes } = Astro.props;
---
<ol class="etapes" style={`--n: ${etapes.length}`} data-stagger>
  {etapes.map((e, i) => (
    <li>
      <span class="num">{i + 1}</span>
      <h3>{e.titre}</h3>
      <p>{e.texte}</p>
    </li>
  ))}
</ol>
<style>
  /* Étapes de procédure : numéro en grand, trait épais en tête, comme une check-list */
  .etapes { list-style: none; margin: clamp(28px, 4vw, 48px) 0 0; padding: 0; display: grid; gap: 28px 20px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  li { position: relative; padding-top: 16px; border-top: 3px solid var(--ink); }
  li:first-child { border-top-color: var(--sun); }
  .num { display: block; font-family: var(--font-title); font-stretch: 75%; font-weight: 800; font-size: 3rem; line-height: 1; color: var(--line); margin-bottom: 12px; }
  .num::before { content: '0'; }
  h3 { font-size: 1.25rem; margin: 0 0 8px; }
  p { margin: 0; color: var(--muted); font-size: .95rem; max-width: 40ch; }
  @media (max-width: 640px) {
    .etapes { gap: 0; }
    li { display: grid; grid-template-columns: 56px 1fr; gap: 0 10px; padding: 16px 0 18px; border-top-width: 1px; border-top-color: var(--line); }
    li:first-child { border-top: 3px solid var(--sun); }
    .num { grid-row: span 2; font-size: 2.4rem; margin: 0; }
  }
</style>
